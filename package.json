{
  "name": "meow-coding",
  "version": "0.26.9",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "build:extension": "node scripts/build-extension.mjs",
    "predev": "npm run build:extension",
    "prebuild": "npm run build:extension",
    "predist": "npm run build:extension && npm run build:cliproxy",
    "predist:dir": "npm run build:extension && npm run build:cliproxy",
    "predist:linux": "npm run build:extension && npm run build:cliproxy",
    "predist:linux:dir": "npm run build:extension && npm run build:cliproxy",
    "predist:mac": "npm run build:extension && npm run build:cliproxy",
    "predist:mac:dir": "npm run build:extension && npm run build:cliproxy",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.extension.json && npm run typecheck:server",
    "typecheck:server": "tsc --noEmit -p server/tsconfig.json",
    "regen:models": "node scripts/regen-models-snapshot.mjs",
    "e2e": "playwright test",
    "dist": "electron-vite build && electron-builder --win",
    "dist:dir": "electron-vite build && electron-builder --dir",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "dist:linux:dir": "electron-vite build && electron-builder --linux dir",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:mac:dir": "electron-vite build && electron-builder --mac dir",
    "build:cliproxy": "node scripts/build-cliproxy.mjs"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "@playwright/test": "^1.62.1",
    "@types/chrome": "^0.0.313",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/turndown": "^5.0.6",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.25.12",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.105",
    "@ai-sdk/google": "^3.0.103",
    "@ai-sdk/openai-compatible": "^2.0.63",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@lydell/node-pty": "^1.2.0-beta.14",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "ai": "^6.0.241",
    "dompurify": "^3.4.13",
    "electron-updater": "^6.8.9",
    "glob": "^13.0.6",
    "lucide-react": "^1.33.0",
    "marked": "^18.0.9",
    "playwright-core": "^1.62.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shiki": "^4.4.3",
    "tree-kill": "^1.2.2",
    "turndown": "^7.2.4",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  }
}
